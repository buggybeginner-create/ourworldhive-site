rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}
function roleOf(uid){return exists(/databases/$(database)/documents/roles/$(uid))?get(/databases/$(database)/documents/roles/$(uid)).data.role:'member';}
function ownerEmail(){return signedIn()&&request.auth.token.email in ['er.krushnananda@gmail.com']&&request.auth.token.email_verified==true;}
function isMod(){return ownerEmail()||(signedIn()&&roleOf(request.auth.uid)=='mod');}
function isAdmin(){return ownerEmail();}
function isBanned(){return exists(/databases/$(database)/documents/bans/$(request.auth.uid));}
function approvalOn(){return exists(/databases/$(database)/documents/config/forum)&&get(/databases/$(database)/documents/config/forum).data.approval==true;}
function okText(v,min,max){return v is string&&v.size()>=min&&v.size()<=max;}
function ownsNew(){return signedIn()&&!isBanned()&&request.resource.data.uid==request.auth.uid;}
match /config/{id}{allow read:if true;allow write:if isAdmin();}
match /roles/{uid}{allow read:if true;allow write:if isAdmin();}
match /bans/{uid}{allow read:if isMod()||(signedIn()&&request.auth.uid==uid);allow write:if isMod();}
match /medals/{uid}{allow read:if true;allow write:if isAdmin();}
match /cms/{id}{allow read:if isAdmin()||resource.data.published==true;allow write:if isAdmin();}
match /media/{id}{allow read:if true;allow write:if isAdmin();}
match /items/{id}{allow read:if true;allow write:if isAdmin();}
match /animals/{id}{allow read:if true;allow write:if isAdmin();}
match /adminEmails/{e}{allow read,write:if isAdmin();}
match /visits/{id}{allow create:if true;allow read,update,delete:if isAdmin();}
match /diary_users/{uid}{allow read:if(signedIn()&&request.auth.uid==uid)||ownerEmail();allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.plan=='free'&&request.resource.data.keys().hasOnly(['uid','email','name','joined','lastSeen','plan'])&&request.resource.data.joined is int&&request.resource.data.joined > request.time.toMillis()- 600000&&request.resource.data.joined < request.time.toMillis()+ 600000;allow update:if ownerEmail()||(signedIn()&&request.auth.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','name','lastSeen']));allow delete:if ownerEmail();}
match /users/{uid}/meta/{k}{allow read,delete:if signedIn()&&request.auth.uid==uid;allow create,update:if signedIn()&&request.auth.uid==uid&&(k=='rules'||k=='templates')&&request.resource.data.keys().hasOnly(['v','updated'])&&request.resource.data.v is string&&request.resource.data.v.size()<=900000;}
match /users/{uid}/pages/{id}{allow read,delete:if signedIn()&&request.auth.uid==uid;allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['date','created','updated','h','n','size','z','v'])&&request.resource.data.n is int&&request.resource.data.n>=1&&request.resource.data.n<=20;
match /parts/{k}{allow read,delete:if signedIn()&&request.auth.uid==uid;allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['k','d'])&&request.resource.data.d is string&&request.resource.data.d.size()<=800000;}}
function likePath(k,u){return /databases/$(database)/documents/eng/$(k)/likes/$(u);}
match /stats/{id}{allow read:if true;allow create:if request.resource.data.keys().hasOnly(['views','visitors'])&&request.resource.data.get('views',0)<=1&&request.resource.data.get('visitors',0)<=1;allow update:if request.resource.data.keys().hasOnly(['views','visitors'])&&request.resource.data.get('views',0)- resource.data.get('views',0)in [0,1]&&request.resource.data.get('visitors',0)- resource.data.get('visitors',0)in [0,1];allow delete:if isAdmin();}
match /eng/{key}{allow read:if true;allow create:if request.resource.data.keys().hasOnly(['views','likes','comments'])&&request.resource.data.get('views',0)<=1&&request.resource.data.get('comments',0)<=1&&(request.resource.data.get('likes',0)==0||(request.resource.data.likes==1&&signedIn()&&existsAfter(likePath(key,request.auth.uid))));allow update:if isAdmin()||(request.resource.data.keys().hasOnly(['views','likes','comments'])&&((request.resource.data.get('likes',0)==resource.data.get('likes',0)&&request.resource.data.get('comments',0)==resource.data.get('comments',0)&&request.resource.data.get('views',0)- resource.data.get('views',0)in [0,1])||(signedIn()&&request.resource.data.get('views',0)==resource.data.get('views',0)&&request.resource.data.get('comments',0)==resource.data.get('comments',0)&&((request.resource.data.get('likes',0)==resource.data.get('likes',0)+ 1&&existsAfter(likePath(key,request.auth.uid))&&!exists(likePath(key,request.auth.uid)))||(request.resource.data.get('likes',0)==resource.data.get('likes',0)- 1&&exists(likePath(key,request.auth.uid))&&!existsAfter(likePath(key,request.auth.uid)))))||(signedIn()&&request.resource.data.get('views',0)==resource.data.get('views',0)&&request.resource.data.get('likes',0)==resource.data.get('likes',0)&&request.resource.data.get('comments',0)- resource.data.get('comments',0)in [-1,1])));
match /likes/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['t']);allow delete:if signedIn()&&request.auth.uid==uid;}
match /comments/{cid}{allow read:if true;allow create:if signedIn()&&!isBanned()&&request.resource.data.uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','name','text','t'])&&okText(request.resource.data.text,1,500)&&okText(request.resource.data.name,1,40);allow delete:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);}}
match /threadhtml/{tid}{allow read:if signedIn();allow create:if signedIn()&&!isBanned()&&request.resource.data.keys().hasOnly(['uid','html','createdAt'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.html is string&&request.resource.data.html.size()>=20&&request.resource.data.html.size()<=400000&&get(/databases/$(database)/documents/threads/$(tid)).data.uid==request.auth.uid;allow update:if signedIn()&&resource.data.uid==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','html','createdAt'])&&request.resource.data.html is string&&request.resource.data.html.size()>=20&&request.resource.data.html.size()<=400000;allow delete:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);}
match /threads/{id}{allow read:if true;allow create:if isMod()||(ownsNew()&&!approvalOn()&&okText(request.resource.data.title,4,120)&&okText(request.resource.data.body,10,5000)&&request.resource.data.pinned==false&&request.resource.data.locked==false);allow update:if isMod()||(signedIn()&&!isBanned()&&resource.data.uid==request.auth.uid&&resource.data.locked==false&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','editedAt'])&&okText(request.resource.data.title,4,120)&&okText(request.resource.data.body,2,5000));allow delete:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);}
match /posts/{id}{allow read:if true;allow create:if isMod()||(ownsNew()&&!approvalOn()&&okText(request.resource.data.body,2,3000)&&exists(/databases/$(database)/documents/threads/$(request.resource.data.tid))&&get(/databases/$(database)/documents/threads/$(request.resource.data.tid)).data.locked==false);allow update:if isMod()||(signedIn()&&!isBanned()&&resource.data.uid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','editedAt'])&&okText(request.resource.data.body,2,3000));allow delete:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);}
match /pending/{id}{allow create:if ownsNew()&&approvalOn()&&request.resource.data.kind in ['thread','post']&&okText(request.resource.data.body,2,5000);allow read:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);allow update:if isMod();allow delete:if isMod()||(signedIn()&&resource.data.uid==request.auth.uid);}
match /reports/{id}{allow create:if signedIn()&&!isBanned()&&request.resource.data.uid==request.auth.uid;allow read,delete:if isMod();}
function roomPath(rid){return /databases/$(database)/documents/arena_rooms/$(rid);}
function resPath(id){return /databases/$(database)/documents/arena_results/$(id);}
function isGame(g){return g is string&&g.matches('^[a-z0-9_-]{2,40}$');}
function isCode(c){return c is string&&c.matches('^[A-Z]{2}$');}
function inRoom(d){return request.auth.uid in d.members;}
match /arena_games/{id}{allow read:if isAdmin()||resource.data.published==true;allow create,update:if isAdmin()&&request.resource.data.html is string&&request.resource.data.html.size()<=760000;allow delete:if isAdmin();}
match /arena_players/{uid}{allow read:if signedIn();allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['uid','name','country','updated'])&&request.resource.data.uid==uid&&okText(request.resource.data.name,2,20)&&isCode(request.resource.data.country);allow delete:if false;}
match /arena_rooms/{rid}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.keys().hasOnly(['game','size','scope','slot','created','expires','status','seed','members','host','started'])&&isGame(request.resource.data.game)&&request.resource.data.size in [2,3,4]&&(request.resource.data.scope=='any'||isCode(request.resource.data.scope))&&request.resource.data.status=='waiting'&&request.resource.data.members==[request.auth.uid]&&request.resource.data.host==request.auth.uid&&request.resource.data.started==0;allow update:if signedIn()&&((resource.data.status=='waiting'&&request.resource.data.status=='waiting'&&!(request.auth.uid in resource.data.members)&&resource.data.members.size()< resource.data.size&&request.resource.data.members.size()==resource.data.members.size()+ 1&&request.resource.data.members.hasAll(resource.data.members)&&request.auth.uid in request.resource.data.members&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))||(resource.data.status=='waiting'&&inRoom(resource.data)&&request.resource.data.status in ['waiting','cancelled']&&!(request.auth.uid in request.resource.data.members)&&request.resource.data.members.size()==resource.data.members.size()- 1&&(request.resource.data.status=='waiting'||request.resource.data.members.size()==0)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','status']))||(resource.data.status=='waiting'&&inRoom(resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expires'])&&request.resource.data.expires<=request.time.toMillis()+ 120000)||(resource.data.status=='waiting'&&inRoom(resource.data)&&request.resource.data.status=='playing'&&request.resource.data.members.size()>=2&&resource.data.members.hasAll(request.resource.data.members)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','members','started']))||(resource.data.status=='playing'&&inRoom(resource.data)&&request.resource.data.status=='finished'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));allow delete:if false;
match /p/{uid}{allow read:if signedIn();allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['uid','name','country','ready','score','final','hb','joined','t','fin','st'])&&request.resource.data.uid==uid&&okText(request.resource.data.name,2,20)&&isCode(request.resource.data.country)&&request.resource.data.score==0&&request.resource.data.final==false&&uid in getAfter(roomPath(rid)).data.members;allow update:if signedIn()&&request.auth.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready','hb','score','t','final','fin','st'])&&(!('st' in request.resource.data)||(request.resource.data.st is list&&request.resource.data.st.size()<=6))&&request.resource.data.score is int&&request.resource.data.score>=0&&request.resource.data.score<=1000000;allow delete:if signedIn()&&request.auth.uid==uid;}}
match /arena_results/{id}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.keys().hasOnly(['rid','uid','game','size','place','points','score','name','country','ts'])&&request.resource.data.uid==request.auth.uid&&id==request.resource.data.rid + '_' + request.auth.uid&&isGame(request.resource.data.game)&&request.resource.data.size in [2,3,4]&&request.resource.data.place is int&&request.resource.data.place>=1&&request.resource.data.place<=request.resource.data.size&&request.resource.data.points==[10,6,3,1][request.resource.data.place - 1]&&request.resource.data.score is int&&request.resource.data.score>=0&&request.resource.data.score<=1000000&&okText(request.resource.data.name,2,20)&&isCode(request.resource.data.country)&&exists(roomPath(request.resource.data.rid))&&request.auth.uid in get(roomPath(request.resource.data.rid)).data.members&&get(roomPath(request.resource.data.rid)).data.status in ['playing','finished']&&get(roomPath(request.resource.data.rid)).data.size==request.resource.data.size&&get(roomPath(request.resource.data.rid)).data.members.size()>=request.resource.data.place;allow update,delete:if false;}
match /arena_lb/{id}{allow read:if true;allow create,update:if signedIn()&&request.resource.data.keys().hasOnly(['uid','name','country','period','points','wins','matches','lastRoom','ts'])&&request.resource.data.uid==request.auth.uid&&id==request.resource.data.period + '__' + request.auth.uid&&request.resource.data.period.matches('^(A|W_[0-9]{4}-W[0-9]{2}|M_[0-9]{4}-[0-9]{2})$')&&okText(request.resource.data.name,2,20)&&isCode(request.resource.data.country)&&existsAfter(resPath(request.resource.data.lastRoom + '_' + request.auth.uid))&&request.resource.data.points==(resource==null?0:resource.data.points)+ getAfter(resPath(request.resource.data.lastRoom + '_' + request.auth.uid)).data.points&&request.resource.data.matches==(resource==null?0:resource.data.matches)+ 1&&request.resource.data.wins==(resource==null?0:resource.data.wins)+(getAfter(resPath(request.resource.data.lastRoom + '_' + request.auth.uid)).data.place==1?1:0);allow delete:if false;}
match /hr_rooms/{c}{allow read:if signedIn();allow create:if signedIn()&&request.auth.uid in request.resource.data.us;allow update:if signedIn();allow delete:if false;
match /moves/{m}{allow read,create:if signedIn();allow update,delete:if false;}
match /chat/{m}{allow read,create:if signedIn();allow update,delete:if false;}}
match /hr_rank/{u}{allow read:if true;allow write:if signedIn()&&request.auth.uid==u;}
match /names/{n}{allow read:if true;allow create:if signedIn();allow update,delete:if signedIn()&&resource.data.uid==request.auth.uid;}
match /hive_records/{id}{allow read:if true;allow write:if signedIn();}
match /game_scores/{g}/p/{u}{allow read:if true;allow write:if signedIn()&&request.auth.uid==u;}
match /game_wallets/{id}{allow read,write:if signedIn()&&(id.matches('.*__' + request.auth.uid)||isAdmin());}
match /wallets/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||isAdmin());allow write:if isAdmin();}
match /store_orders/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=='pending';allow read:if signedIn()&&(resource.data.uid==request.auth.uid||isAdmin());allow update,delete:if isAdmin();}
function pmPlant(c){return /databases/$(database)/documents/pm_plants/$(c);}
function pmMem(c,u){return /databases/$(database)/documents/pm_plants/$(c)/members/$(u);}
function pmActive(c){return signedIn()&&exists(pmMem(c,request.auth.uid))&&get(pmMem(c,request.auth.uid)).data.status=='active';}
function pmManager(c){return pmActive(c)&&get(pmMem(c,request.auth.uid)).data.role in ['manager','admin'];}
function pmAdmin(c){return signedIn()&&get(pmPlant(c)).data.ownerUid==request.auth.uid;}
function pmCfg(c){return /databases/$(database)/documents/pm_plants/$(c)/cfg/main;}
function pmMine(c,a){return a==''||a==request.auth.uid||(a.matches('g_.*')&&request.auth.uid in get(pmCfg(c)).data.get('gm',{}).get(a,[]));}
function pmPlanOk(c){return get(pmPlant(c)).data.plan=='permanent'||(get(pmPlant(c)).data.plan in ['trial','monthly']&&get(pmPlant(c)).data.expiresMs > request.time.toMillis());}
match /pm_config/{id}{allow read:if true;allow write:if ownerEmail();}
match /pm_users/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['plants','trialUsed'])&&(!exists(/databases/$(database)/documents/pm_users/$(uid))||resource.data.get('trialUsed',false)==false||request.resource.data.trialUsed==true);allow delete:if signedIn()&&request.auth.uid==uid;allow read,write:if ownerEmail();}
match /pm_plants/{code}{allow get:if signedIn();allow list:if ownerEmail();allow create:if signedIn()&&request.resource.data.keys().hasOnly(['name','plan','expiresMs','created','createdMs','alertDays','basis','ownerUid','mgrName','mgrContact'])&&request.resource.data.ownerUid==request.auth.uid&&getAfter(pmMem(code,request.auth.uid)).data.role in ['manager','admin']&&((request.resource.data.plan=='trial'&&request.resource.data.expiresMs > request.time.toMillis()&&request.resource.data.expiresMs<=request.time.toMillis()+ 2678400000&&!(exists(/databases/$(database)/documents/pm_users/$(request.auth.uid))&&get(/databases/$(database)/documents/pm_users/$(request.auth.uid)).data.get('trialUsed',false)==true)&&getAfter(/databases/$(database)/documents/pm_users/$(request.auth.uid)).data.trialUsed==true)||(ownerEmail()&&request.resource.data.plan in ['permanent','trial','monthly']));allow update:if ownerEmail()||(pmAdmin(code)&&pmPlanOk(code)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','alertDays','basis']));allow delete:if false;
match /cfg/{doc}{allow read:if pmActive(code);allow create:if signedIn()&&getAfter(pmMem(code,request.auth.uid)).data.role in ['manager','admin']&&getAfter(pmPlant(code)).data.ownerUid==request.auth.uid&&!exists(pmPlant(code));allow update:if pmPlanOk(code)&&(pmAdmin(code)||(pmManager(code)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sections','types','forms','dd','sdp','groups','gm'])));}
match /members/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||pmActive(code));allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['name','contact','email','role','status','joined','sec','empId','photo'])&&((request.resource.data.role=='user'&&request.resource.data.status=='pending'&&exists(pmPlant(code)))||(request.resource.data.role in ['manager','admin']&&request.resource.data.status=='active'&&!exists(pmPlant(code))&&getAfter(pmPlant(code)).data.ownerUid==uid));allow update:if(pmAdmin(code)&&pmPlanOk(code)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','name','contact','email','joined','empId']))||(signedIn()&&request.auth.uid==get(pmPlant(code)).data.ownerUid&&pmPlanOk(code)&&uid!=request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role','name','contact','email','joined','empId']))||(signedIn()&&request.auth.uid==uid&&resource.data.status=='active'&&pmPlanOk(code)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','empId','photo'])&&request.resource.data.name is string&&request.resource.data.name.size()<=60&&request.resource.data.empId is string&&request.resource.data.empId.size()<=20&&request.resource.data.photo is string&&request.resource.data.photo.size()<=60000)||(signedIn()&&request.auth.uid==uid&&resource.data.status=='active'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens'])&&request.resource.data.tokens is list&&request.resource.data.tokens.size()<=5);allow delete:if pmAdmin(code)&&pmPlanOk(code)&&uid!=request.auth.uid&&uid!=get(pmPlant(code)).data.ownerUid||(signedIn()&&request.auth.uid==uid&&uid!=get(pmPlant(code)).data.ownerUid);}
match /tasks/{id}{allow read:if pmActive(code);allow create,delete:if pmManager(code)&&pmPlanOk(code);allow update:if pmPlanOk(code)&&(pmManager(code)||(pmActive(code)&&pmMine(code,resource.data.get('assignee',''))&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['due','lastDone','closed','pct'])));}
match /payments/{id}{allow read:if pmAdmin(code)||ownerEmail();allow write:if false;}
match /logs/{id}{allow read:if pmActive(code);allow create:if pmActive(code)&&pmPlanOk(code)&&request.resource.data.doneBy==request.auth.uid&&(pmManager(code)||pmMine(code,request.resource.data.get('assignee','')));allow update:if pmManager(code)&&pmPlanOk(code)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crew','resp','mp','doneBy']);allow delete:if pmActive(code)&&pmPlanOk(code)&&(pmManager(code)||resource.data.doneBy==request.auth.uid);}
match /mats/{id}{allow read:if pmActive(code);allow create:if pmActive(code)&&pmPlanOk(code)&&request.resource.data.by==request.auth.uid;allow update:if pmActive(code)&&pmPlanOk(code)&&request.resource.data.get('stk',0)==resource.data.get('stk',0)&&(pmManager(code)||resource.data.get('by','')==request.auth.uid||(resource.data.get('stk',0)==1&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty','ts'])));allow delete:if pmActive(code)&&pmPlanOk(code)&&(pmManager(code)||(resource.data.get('stk',0)==0&&resource.data.get('by','')==request.auth.uid));}
match /bds/{id}{allow read:if pmActive(code);allow create:if pmActive(code)&&pmPlanOk(code)&&request.resource.data.by==request.auth.uid&&(request.resource.data.status=='pending'||pmManager(code));allow update,delete:if pmManager(code)&&pmPlanOk(code);}}
function ppP(pid){return /databases/$(database)/documents/pp_projects/$(pid);}
function ppM(pid,u){return /databases/$(database)/documents/pp_projects/$(pid)/members/$(u);}
function ppAct(pid){return signedIn()&&exists(ppM(pid,request.auth.uid))&&get(ppM(pid,request.auth.uid)).data.status=='active';}
function ppRole(pid){return get(ppM(pid,request.auth.uid)).data.role;}
function ppIsPlanner(pid){return ppAct(pid)&&ppRole(pid)=='planner';}
function ppIsMgr(pid){return ppAct(pid)&&ppRole(pid)=='manager';}
function ppIsEng(pid){return ppAct(pid)&&ppRole(pid)in ['engineer','contributor'];}
function ppIsSup(pid){return ppAct(pid)&&ppRole(pid)in ['supervisor','contractor'];}
function ppHasSec(pid,sid){return get(ppM(pid,request.auth.uid)).data.get('secs',[]).hasAny([sid]);}
function ppNoSecs(pid){return get(ppM(pid,request.auth.uid)).data.get('secs',[]).size()==0;}
function ppPlanOk(pid){return get(ppP(pid)).data.plan=='permanent'||(get(ppP(pid)).data.plan in ['trial','monthly']&&get(ppP(pid)).data.expiresMs > request.time.toMillis());}
function ppHidden(pid,sid,k){return get(ppP(pid)).data.get('hide',{}).get(sid,{}).get(k,false)==true;}
function ppTrkRead(pid,key){return ppIsPlanner(pid)||(ppIsMgr(pid)&&(key.split('_')[1]!='man'||ppNoSecs(pid)||ppHasSec(pid,key.split('_')[0])))||(ppIsEng(pid)&&(ppHasSec(pid,key.split('_')[0])||key.split('_')[1]=='xtr'||!ppHidden(pid,key.split('_')[0],key.split('_')[1])))||(ppIsSup(pid)&&key.split('_')[1]=='man'&&ppHasSec(pid,key.split('_')[0]));}
function ppTrkEdit(pid,key){return ppIsPlanner(pid)||(ppIsEng(pid)&&ppHasSec(pid,key.split('_')[0]))||(ppIsSup(pid)&&key.split('_')[1]=='man'&&ppHasSec(pid,key.split('_')[0]))||(ppIsMgr(pid)&&(key.split('_')[1]=='xtr'||(key.split('_')[1]=='man'&&(ppNoSecs(pid)||ppHasSec(pid,key.split('_')[0])))));}
match /pp_config/{id}{allow read:if true;allow write:if ownerEmail();}
match /pp_codes/{code}{allow read:if true;allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;allow update:if false;allow delete:if ownerEmail();}
match /pp_users/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||ownerEmail());allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['email','name','projs','trialUsed'])&&(!exists(/databases/$(database)/documents/pp_users/$(uid))||resource.data.get('trialUsed',false)==false||request.resource.data.get('trialUsed',false)==true);allow delete:if ownerEmail()||(signedIn()&&request.auth.uid==uid);}
