<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/wbg_dark" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/prev" android:layout_width="40dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textSize="24sp" android:textColor="#FFC94D" android:background="@drawable/btn_round" />
        <LinearLayout android:id="@+id/mhead" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/mTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#F3EAD8" android:text="Panchang" />
            <TextView android:id="@+id/mSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFC94D" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/next" android:layout_width="40dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="#FFC94D" android:background="@drawable/btn_round" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wdrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" />
    <LinearLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
