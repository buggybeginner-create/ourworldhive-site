<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme. Compose draws everything; this only sets the window background and bars. -->
    <style name="Theme.SmartSMS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash (Android 12+ style, back-ported by core-splashscreen) -->
    <style name="Theme.SmartSMS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartSMS</item>
    </style>
</resources>
