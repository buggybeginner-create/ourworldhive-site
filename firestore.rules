match /plants/{c}{allow read,write:if request.auth!=null&&request.auth.uid==u;}}
match /ep_plants/{c}{allow get:if request.auth!=null;allow list:if ownerEmail();allow create:if request.auth!=null&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.name is string&&request.resource.data.name.size()<=60&&((ownerEmail()&&request.resource.data.get('plan','permanent')in ['permanent','trial','monthly'])||(request.resource.data.get('plan','')=='trial'&&request.resource.data.get('expiresMs',0)> request.time.toMillis()&&request.resource.data.get('expiresMs',0)<=request.time.toMillis()+ 2678400000&&!(exists(epUser(request.auth.uid))&&get(epUser(request.auth.uid)).data.get('trialUsed',false)==true)&&getAfter(epUser(request.auth.uid)).data.trialUsed==true));allow update:if ownerEmail()||(epAdmin(c)&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan','expiresMs']));allow delete:if false;
match /members/{u}{allow read:if request.auth!=null&&(request.auth.uid==u||epAct(c));allow create:if request.auth!=null&&request.auth.uid==u&&((request.resource.data.role=='user'&&request.resource.data.status=='pending'&&exists(epPlant(c)))||(request.resource.data.role in ['manager','admin']&&request.resource.data.status=='active'&&!exists(epPlant(c))&&getAfter(epPlant(c)).data.ownerUid==request.auth.uid));allow update:if epAdmin(c)||(request.auth!=null&&request.auth.uid==u&&resource.data.status=='active'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens'])&&request.resource.data.tokens is list&&request.resource.data.tokens.size()<=5)||(request.auth!=null&&request.auth.uid==u&&resource.data.status=='active'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pend'])&&(request.resource.data.pend==null||request.resource.data.pend is map))||(request.auth!=null&&request.auth.uid==u&&resource.data.status=='active'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','empId','photo'])&&request.resource.data.name is string&&request.resource.data.name.size()<=60&&request.resource.data.empId is string&&request.resource.data.empId.size()<=20&&request.resource.data.photo is string&&request.resource.data.photo.size()<=60000)||(epHod(c)&&u!=request.auth.uid&&resource.data.status=='active'&&((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pend','auth'])&&resource.data.get('dept','')==epMy(c).get('dept',''))||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pend','dept','iso','auth','role'])&&request.resource.data.dept==epMy(c).get('dept','')&&request.resource.data.get('role','')in ['user',resource.data.get('role','')])));allow delete:if(epAdmin(c)&&u!=request.auth.uid)||(request.auth!=null&&request.auth.uid==u&&get(epPlant(c)).data.ownerUid!=u);}
