<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/widget_bg" android:padding="10dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NIFTY 50" android:textColor="#FFC857" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:id="@+id/nv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EAF1FF" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" />
        <TextView android:id="@+id/np" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B8C4E0" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BANK NIFTY" android:textColor="#7D8BAD" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:id="@+id/bv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EAF1FF" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" />
        <TextView android:id="@+id/bp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B8C4E0" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
