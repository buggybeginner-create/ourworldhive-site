match /permits/{id}{allow read:if epAct(c);allow create:if epAct(c)&&epPlanOk(c)&&request.resource.data.by==request.auth.uid&&request.resource.data.st=='raised';allow update:if epRevokeOk()&&epDecideOk(c)&&(epOps(c)||(epIso(c)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iso','log','upd']))||(epAct(c)&&resource.data.by==request.auth.uid&&(request.resource.data.st in ['raised','closreq','cancelled']||request.resource.data.st==resource.data.st)));allow delete:if epMgr(c)||(resource.data.by==request.auth.uid&&resource.data.get('ap',null)==null&&resource.data.st in ['raised','verified','rejected','cancelled']);}}
