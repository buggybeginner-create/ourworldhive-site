function epPlant(c){return /databases/$(database)/documents/ep_plants/$(c);}
function epMemP(c,u){return /databases/$(database)/documents/ep_plants/$(c)/members/$(u);}
function epAct(c){return request.auth!=null&&exists(epMemP(c,request.auth.uid))&&get(epMemP(c,request.auth.uid)).data.status=='active';}
function epRole(c){return get(epMemP(c,request.auth.uid)).data.role;}
function epAdmin(c){return request.auth!=null&&get(epPlant(c)).data.ownerUid==request.auth.uid;}
function epMgr(c){return epAct(c)&&epRole(c)in ['manager','admin'];}
function epOps(c){return epAct(c)&&epRole(c)in ['manager','admin','incharge','issuer','safety'];}
function epIso(c){return epAct(c)&&get(epMemP(c,request.auth.uid)).data.get('iso',false)==true;}
function epMy(c){return get(epMemP(c,request.auth.uid)).data;}
function epApprover(c,d){return epAct(c)&&(epRole(c)in ['manager','admin']||((epRole(c)=='hod'||epMy(c).get('auth',false)==true)&&epMy(c).get('dept','')==d));}
function epHod(c){return epAct(c)&&epRole(c)=='hod';}
function epRevokeOk(){return !(resource.data.st=='active'&&request.resource.data.st in ['raised','verified'])||(resource.data.get('ap',null)!=null&&resource.data.ap.by==request.auth.uid);}
function epDecideOk(c){return !(resource.data.st in ['raised','verified']&&request.resource.data.st in ['active','rejected'])||epApprover(c,resource.data.dept);}
function epUser(u){return /databases/$(database)/documents/ep_users/$(u);}
function epPlanOk(c){return get(epPlant(c)).data.get('plan','permanent')=='permanent'||(get(epPlant(c)).data.get('plan','permanent')in ['trial','monthly']&&get(epPlant(c)).data.get('expiresMs',0)> request.time.toMillis());}
