function sfIn(){return request.auth!=null;}
function sfCo(c){return /databases/$(database)/documents/sf_companies/$(c);}
function sfMem(c){return /databases/$(database)/documents/sf_companies/$(c)/members/$(request.auth.uid);}
function sfOwner(c){return getAfter(sfCo(c)).data.ownerUid==request.auth.uid;}
function sfActive(c){return exists(sfMem(c))&&get(sfMem(c)).data.status=='active';}
function sfMgr(c){return sfActive(c)&&get(sfMem(c)).data.role in ['admin','moderator'];}
match /sf_users/{u}{allow read,write:if sfIn()&&request.auth.uid==u;}
match /sf_companies/{c}{allow read:if sfIn();allow create:if sfIn()&&request.resource.data.ownerUid==request.auth.uid&&!('plan' in request.resource.data)&&!('disabled' in request.resource.data);allow update:if ownerEmail()||(sfActive(c)&&get(sfMem(c)).data.role=='admin'&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan','expiresMs','planAt','payNote','ownerUid','ownerEmail','disabled']));allow delete:if false;
