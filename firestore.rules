function mmOk(u){return exists(mmU(u))&&(get(mmU(u)).data.plan=='permanent'||get(mmU(u)).data.expiresMs > request.time.toMillis());}
function mmM(m){return /databases/$(database)/documents/mm_maps/$(m);}
function mmCanRead(d){return d.pub==true||(signedIn()&&(d.uid==request.auth.uid||request.auth.token.email in d.editors||request.auth.token.email in d.viewers))||ownerEmail();}
function mmCanEdit(d){return signedIn()&&((d.uid==request.auth.uid&&(mmOk(request.auth.uid)||ownerEmail()))||(request.auth.token.email in d.editors&&mmOk(d.uid)));}
function mmValid(d){return d.title is string&&d.title.size()>=1&&d.title.size()<=80&&d.editors is list&&d.editors.size()<=20&&d.viewers is list&&d.viewers.size()<=50&&d.pub is bool&&d.items is map&&d.items.size()<=3000;}
match /mm_config/{id}{allow read:if true;allow write:if ownerEmail();}
match /mm_users/{u}{allow read:if signedIn()&&(request.auth.uid==u||ownerEmail());allow create:if signedIn()&&request.auth.uid==u&&request.auth.token.firebase.sign_in_provider!='anonymous'&&request.resource.data.keys().hasOnly(['uid','email','name','plan','expiresMs','joined','lastSeen'])&&request.resource.data.uid==u&&request.resource.data.plan=='trial'&&request.resource.data.expiresMs<=request.time.toMillis()+ 2678400000;allow update:if ownerEmail()||(signedIn()&&request.auth.uid==u&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','lastSeen']));allow delete:if ownerEmail();}
match /mm_maps/{m}{allow read:if mmCanRead(resource.data);allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&(mmOk(request.auth.uid)||ownerEmail())&&request.resource.data.keys().hasOnly(['uid','email','title','editors','viewers','pub','items','ts','upd'])&&mmValid(request.resource.data);allow update:if mmCanEdit(resource.data)&&mmValid(request.resource.data)&&request.resource.data.uid==resource.data.uid&&(resource.data.uid==request.auth.uid?request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','editors','viewers','pub','items','upd']):request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items','upd']));allow delete:if signedIn()&&resource.data.uid==request.auth.uid;
match /ph/{p}{allow read:if mmCanRead(get(mmM(m)).data);allow create:if mmCanEdit(get(mmM(m)).data)&&request.resource.data.keys().hasOnly(['d','uid','ts'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.d is string&&request.resource.data.d.size()<=400000;allow delete:if signedIn()&&(get(mmM(m)).data.uid==request.auth.uid||resource.data.uid==request.auth.uid);}}
match /mt_users/{u}/items/{id}{allow read,delete:if signedIn()&&request.auth.uid==u;allow create,update:if signedIn()&&request.auth.uid==u&&request.auth.token.firebase.sign_in_provider!='anonymous'&&request.resource.data.keys().hasOnly(['d','upd','del'])&&request.resource.data.d is string&&request.resource.data.d.size()<=6000&&request.resource.data.upd is number&&request.resource.data.del is bool;}}}